# Reclaimed hardware bridge. Copy to .env (gitignored) and fill in.

# Identifies this laptop in tap events.
TERMINAL_ID=store-laptop-1

# Where taps go: websocket (store page on this laptop), http (backend), or both.
TAP_OUTPUT=websocket

# WebSocket server for the store page. Binds to 127.0.0.1 only.
WS_PORT=8787

# Backend endpoint for TAP_OUTPUT=http or both. Tap is POSTed to BACKEND_URL + TAP_PATH.
BACKEND_URL=http://localhost:3000
TAP_PATH=/hardware/taps

# Shared secret for signing HTTP taps (HMAC-SHA256). Required for http/both.
# Generate with: openssl rand -hex 32
HARDWARE_BRIDGE_SECRET=

# UID sent when you press "f" in the bridge terminal (fake tap). Uppercase hex, no separators.
DEMO_CARD_UID=

# Ignore the same card if seen again within this many milliseconds.
DEBOUNCE_MS=1500

# trace, debug, info, warn, error
LOG_LEVEL=info
