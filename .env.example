# =============================================================================
# Reclaimed Phase 1 — environment template. Copy to `.env` (never commit `.env`).
# Defaults run fully locally: Supabase local, Plaid Sandbox, mock processor,
# mock bill pay. NOTHING here can move real money.
# =============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
# Browser origins allowed by CORS (terminal simulator, Expo web).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
LOG_LEVEL=info

# ---------- Supabase ----------
# `npm run db:start` prints these values for the local stack (supabase status).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Backend-only. Needed for account deletion (auth.admin.deleteUser). Never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by the API for transactional writes.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- Plaid (Sandbox; free developer account at dashboard.plaid.com) ----------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Products requested by new Link tokens (comma-separated; must include transactions).
PLAID_PRODUCTS=transactions
# Plaid country codes for Link and institution lookups (comma-separated).
PLAID_COUNTRY_CODES=US
# 32 random bytes, base64:  openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
ENABLE_PLAID_LIABILITIES=true
# Public HTTPS URL that forwards to http://localhost:4000/api/v1/webhooks/plaid (e.g. a tunnel). Optional.
PLAID_WEBHOOK_URL=
# Verify the Plaid-Verification JWT on webhooks (keep true).
PLAID_VERIFY_WEBHOOKS=true
# Android package name registered in the Plaid dashboard (Allowed Android package names).
PLAID_ANDROID_PACKAGE_NAME=com.reclaimed.app
# Only needed for OAuth institutions on iOS (must be registered in the Plaid dashboard).
PLAID_REDIRECT_URI=

# ---------- Lithic (Sandbox; optional) ----------
LITHIC_API_KEY=
LITHIC_ENVIRONMENT=sandbox
# Event webhook secret (whsec_…) from the Lithic dashboard / event subscription.
LITHIC_WEBHOOK_SECRET=
# ASA HMAC secret (GET /v1/auth_stream/secret) — enables /webhooks/lithic/asa.
LITHIC_ASA_SECRET=

# ---------- NFC hardware ----------
NFC_READER_MODEL="ACS ACR1252U"
# Regex matched against PC/SC reader names. The ACR1252U PICC (contactless) slot:
NFC_READER_FILTER=ACR1252.*PICC
# Shared secret for HMAC-signed bridge → API requests (min 16 chars): openssl rand -hex 32
HARDWARE_BRIDGE_SECRET=
# Keyed pepper for NFC UID fingerprints (defaults to HARDWARE_BRIDGE_SECRET when empty).
NFC_UID_PEPPER=
HARDWARE_BRIDGE_ID=bridge-macbook
BRIDGE_API_URL=http://localhost:4000
# Allows test enrollment outside NODE_ENV=development.
HARDWARE_TEST_MODE=false
# Ignore re-detections of the same card on the same reader within this window.
TAP_DEBOUNCE_MS=1500

# ---------- Simulation ----------
# mock | lithic_sandbox
PAYMENT_MODE=mock
BILL_PAYMENT_MODE=mock
TEST_TERMINAL_ENABLED=true
# Terminal simulator identity. `npm run db:seed` stores sha256(secret) for this terminal.
TEST_TERMINAL_ID=TERM-DEV-001
TEST_TERMINAL_SECRET=
TERMINAL_API_URL=http://localhost:4000
TERMINAL_GATEWAY_PORT=5174
CHECKOUT_TTL_MS=90000
AUTHORIZATION_TIMEOUT_MS=5000
ENROLLMENT_TTL_MS=60000
SETTLEMENT_DELAY_MS=3000
BILL_PAY_STEP_MS=4000

# ---------- Mobile (Expo) — the app reads mobile/.env (see mobile/.env.example) ----------
# Use your Mac's LAN IP (not localhost) when running on a physical phone.
