{
 "$schema": "https://design-tokens.org (W3C DTCG draft)",
 "brand": {
  "$description": "Tier 1. Raw values only. No roles. Nothing in components references this tier directly.",
  "color": {
   "neutral": {
    "0": {"$type": "color", "$value": "#FFFFFF"},
    "50": {"$type": "color", "$value": "#FAFAFA"},
    "100": {"$type": "color", "$value": "#F5F5F5"},
    "200": {"$type": "color", "$value": "#E5E5E5"},
    "300": {"$type": "color", "$value": "#D4D4D4"},
    "400": {"$type": "color", "$value": "#A3A3A3"},
    "450": {"$type": "color", "$value": "#8C8C8C"},
    "500": {"$type": "color", "$value": "#737373"},
    "600": {"$type": "color", "$value": "#525252"},
    "700": {"$type": "color", "$value": "#404040"},
    "800": {"$type": "color", "$value": "#262626"},
    "850": {"$type": "color", "$value": "#1F1F1F"},
    "900": {"$type": "color", "$value": "#171717"},
    "950": {"$type": "color", "$value": "#0A0A0A"},
    "1000": {"$type": "color", "$value": "#000000"}
   },
   "red": {
    "300": {"$type": "color", "$value": "#FCA5A5"},
    "400": {"$type": "color", "$value": "#F87171"},
    "500": {"$type": "color", "$value": "#EF4444"},
    "600": {"$type": "color", "$value": "#DC2626"},
    "700": {"$type": "color", "$value": "#B91C1C"}
   }
  },
  "font": {
   "family": {
    "mono": {"$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]}
   },
   "weight": {
    "regular": {"$type": "fontWeight", "$value": 400},
    "medium": {"$type": "fontWeight", "$value": 500},
    "bold": {"$type": "fontWeight", "$value": 700}
   }
  },
  "scale": {
   "0": {"$type": "dimension", "$value": "0px"},
   "25": {"$type": "dimension", "$value": "1px"},
   "50": {"$type": "dimension", "$value": "2px"},
   "100": {"$type": "dimension", "$value": "4px"},
   "200": {"$type": "dimension", "$value": "8px"},
   "300": {"$type": "dimension", "$value": "12px"},
   "400": {"$type": "dimension", "$value": "16px"},
   "500": {"$type": "dimension", "$value": "20px"},
   "600": {"$type": "dimension", "$value": "24px"},
   "700": {"$type": "dimension", "$value": "28px"},
   "800": {"$type": "dimension", "$value": "32px"},
   "900": {"$type": "dimension", "$value": "40px"},
   "1000": {"$type": "dimension", "$value": "48px"},
   "1100": {"$type": "dimension", "$value": "56px"},
   "1200": {"$type": "dimension", "$value": "64px"},
   "1300": {"$type": "dimension", "$value": "80px"},
   "1400": {"$type": "dimension", "$value": "96px"}
  }
 },
 "alias": {
  "$description": "Tier 2. Gives raw values a role. Add brand modes here if you ever need a second brand.",
  "color": {
   "neutral": {
    "0": {"$type": "color", "$value": "{brand.color.neutral.0}"},
    "50": {"$type": "color", "$value": "{brand.color.neutral.50}"},
    "100": {"$type": "color", "$value": "{brand.color.neutral.100}"},
    "200": {"$type": "color", "$value": "{brand.color.neutral.200}"},
    "300": {"$type": "color", "$value": "{brand.color.neutral.300}"},
    "400": {"$type": "color", "$value": "{brand.color.neutral.400}"},
    "450": {"$type": "color", "$value": "{brand.color.neutral.450}"},
    "500": {"$type": "color", "$value": "{brand.color.neutral.500}"},
    "600": {"$type": "color", "$value": "{brand.color.neutral.600}"},
    "700": {"$type": "color", "$value": "{brand.color.neutral.700}"},
    "800": {"$type": "color", "$value": "{brand.color.neutral.800}"},
    "850": {"$type": "color", "$value": "{brand.color.neutral.850}"},
    "900": {"$type": "color", "$value": "{brand.color.neutral.900}"},
    "950": {"$type": "color", "$value": "{brand.color.neutral.950}"},
    "1000": {"$type": "color", "$value": "{brand.color.neutral.1000}"}
   },
   "error": {
    "300": {"$type": "color", "$value": "{brand.color.red.300}"},
    "400": {"$type": "color", "$value": "{brand.color.red.400}"},
    "500": {"$type": "color", "$value": "{brand.color.red.500}"},
    "600": {"$type": "color", "$value": "{brand.color.red.600}"},
    "700": {"$type": "color", "$value": "{brand.color.red.700}"}
   },
   "white": {"$type": "color", "$value": "{brand.color.neutral.0}"},
   "black": {"$type": "color", "$value": "{brand.color.neutral.900}"}
  },
  "radius": {
   "none": {"$type": "dimension", "$value": "{brand.scale.0}"},
   "sm": {"$type": "dimension", "$value": "{brand.scale.100}"},
   "md": {"$type": "dimension", "$value": "{brand.scale.200}"},
   "lg": {"$type": "dimension", "$value": "{brand.scale.300}"},
   "xl": {"$type": "dimension", "$value": "{brand.scale.400}"},
   "full": {"$type": "dimension", "$value": "9999px"}
  },
  "border-width": {
   "sm": {"$type": "dimension", "$value": "{brand.scale.25}"},
   "md": {"$type": "dimension", "$value": "{brand.scale.50}"}
  }
 },
 "mapped": {
  "$description": "Tier 3. What components use. Modes: dark (default), light. Every text pair is checked to WCAG AA 4.5:1.",
  "text": {
   "primary": {"$type": "color", "$value": "{alias.color.neutral.50}", "$extensions": {"modes": {"dark": "{alias.color.neutral.50}", "light": "{alias.color.neutral.900}"}}, "$description": "Headings and body"},
   "secondary": {"$type": "color", "$value": "{alias.color.neutral.400}", "$extensions": {"modes": {"dark": "{alias.color.neutral.400}", "light": "{alias.color.neutral.600}"}}, "$description": "Supporting text"},
   "tertiary": {"$type": "color", "$value": "{alias.color.neutral.450}", "$extensions": {"modes": {"dark": "{alias.color.neutral.450}", "light": "{alias.color.neutral.500}"}}, "$description": "Captions, metadata. Light mode: only on page or surface.default"},
   "disabled": {"$type": "color", "$value": "{alias.color.neutral.450}", "$extensions": {"modes": {"dark": "{alias.color.neutral.450}", "light": "{alias.color.neutral.500}"}}, "$description": "Must stay readable: 4.5:1 on page, default, and disabled surfaces"},
   "action": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.900}"}}, "$description": "Links. Always underlined, color alone is not enough"},
   "action-hover": {"$type": "color", "$value": "{alias.color.neutral.300}", "$extensions": {"modes": {"dark": "{alias.color.neutral.300}", "light": "{alias.color.neutral.700}"}}},
   "on-action": {"$type": "color", "$value": "{alias.color.neutral.900}", "$extensions": {"modes": {"dark": "{alias.color.neutral.900}", "light": "{alias.color.neutral.0}"}}, "$description": "Text on surface.action"},
   "error": {"$type": "color", "$value": "{alias.color.error.400}", "$extensions": {"modes": {"dark": "{alias.color.error.400}", "light": "{alias.color.error.600}"}}},
   "on-error": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.0}"}}}
  },
  "icon": {
   "primary": {"$type": "color", "$value": "{alias.color.neutral.50}", "$extensions": {"modes": {"dark": "{alias.color.neutral.50}", "light": "{alias.color.neutral.900}"}}, "$description": "Matches text.primary so icons and labels stay in sync"},
   "secondary": {"$type": "color", "$value": "{alias.color.neutral.400}", "$extensions": {"modes": {"dark": "{alias.color.neutral.400}", "light": "{alias.color.neutral.600}"}}},
   "tertiary": {"$type": "color", "$value": "{alias.color.neutral.450}", "$extensions": {"modes": {"dark": "{alias.color.neutral.450}", "light": "{alias.color.neutral.500}"}}},
   "disabled": {"$type": "color", "$value": "{alias.color.neutral.450}", "$extensions": {"modes": {"dark": "{alias.color.neutral.450}", "light": "{alias.color.neutral.500}"}}},
   "action": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.900}"}}},
   "action-hover": {"$type": "color", "$value": "{alias.color.neutral.300}", "$extensions": {"modes": {"dark": "{alias.color.neutral.300}", "light": "{alias.color.neutral.700}"}}},
   "on-action": {"$type": "color", "$value": "{alias.color.neutral.900}", "$extensions": {"modes": {"dark": "{alias.color.neutral.900}", "light": "{alias.color.neutral.0}"}}},
   "error": {"$type": "color", "$value": "{alias.color.error.400}", "$extensions": {"modes": {"dark": "{alias.color.error.400}", "light": "{alias.color.error.600}"}}},
   "on-error": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.0}"}}}
  },
  "surface": {
   "page": {"$type": "color", "$value": "{alias.color.neutral.900}", "$extensions": {"modes": {"dark": "{alias.color.neutral.900}", "light": "{alias.color.neutral.0}"}}, "$description": "App background"},
   "default": {"$type": "color", "$value": "{alias.color.neutral.850}", "$extensions": {"modes": {"dark": "{alias.color.neutral.850}", "light": "{alias.color.neutral.50}"}}, "$description": "Cards, grouped content"},
   "raised": {"$type": "color", "$value": "{alias.color.neutral.800}", "$extensions": {"modes": {"dark": "{alias.color.neutral.800}", "light": "{alias.color.neutral.0}"}}, "$description": "Menus, popovers, sheets. Light mode adds shadow"},
   "field": {"$type": "color", "$value": "{alias.color.neutral.850}", "$extensions": {"modes": {"dark": "{alias.color.neutral.850}", "light": "{alias.color.neutral.0}"}}, "$description": "Inputs"},
   "hover": {"$type": "color", "$value": "{alias.color.neutral.800}", "$extensions": {"modes": {"dark": "{alias.color.neutral.800}", "light": "{alias.color.neutral.100}"}}, "$description": "Ghost button and row hover"},
   "selected": {"$type": "color", "$value": "{alias.color.neutral.700}", "$extensions": {"modes": {"dark": "{alias.color.neutral.700}", "light": "{alias.color.neutral.200}"}}, "$description": "Selected row, active tab"},
   "action": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.900}"}}, "$description": "Primary button. Mono accent"},
   "action-hover": {"$type": "color", "$value": "{alias.color.neutral.200}", "$extensions": {"modes": {"dark": "{alias.color.neutral.200}", "light": "{alias.color.neutral.800}"}}},
   "disabled": {"$type": "color", "$value": "{alias.color.neutral.800}", "$extensions": {"modes": {"dark": "{alias.color.neutral.800}", "light": "{alias.color.neutral.50}"}}},
   "error": {"$type": "color", "$value": "{alias.color.error.600}", "$extensions": {"modes": {"dark": "{alias.color.error.600}", "light": "{alias.color.error.600}"}}, "$description": "Destructive button"},
   "error-hover": {"$type": "color", "$value": "{alias.color.error.700}", "$extensions": {"modes": {"dark": "{alias.color.error.700}", "light": "{alias.color.error.700}"}}}
  },
  "border": {
   "default": {"$type": "color", "$value": "{alias.color.neutral.800}", "$extensions": {"modes": {"dark": "{alias.color.neutral.800}", "light": "{alias.color.neutral.200}"}}, "$description": "Cards, fields at rest"},
   "strong": {"$type": "color", "$value": "{alias.color.neutral.700}", "$extensions": {"modes": {"dark": "{alias.color.neutral.700}", "light": "{alias.color.neutral.300}"}}, "$description": "Hover, dividers that must read"},
   "control": {"$type": "color", "$value": "{alias.color.neutral.500}", "$extensions": {"modes": {"dark": "{alias.color.neutral.500}", "light": "{alias.color.neutral.450}"}}, "$description": "Edges of inputs and unchecked controls. 3:1 against page and surfaces"},
   "control-hover": {"$type": "color", "$value": "{alias.color.neutral.400}", "$extensions": {"modes": {"dark": "{alias.color.neutral.400}", "light": "{alias.color.neutral.600}"}}},
   "action": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.900}"}}},
   "focus": {"$type": "color", "$value": "{alias.color.neutral.0}", "$extensions": {"modes": {"dark": "{alias.color.neutral.0}", "light": "{alias.color.neutral.900}"}}, "$description": "2px ring, 2px offset"},
   "disabled": {"$type": "color", "$value": "{alias.color.neutral.800}", "$extensions": {"modes": {"dark": "{alias.color.neutral.800}", "light": "{alias.color.neutral.200}"}}},
   "error": {"$type": "color", "$value": "{alias.color.error.400}", "$extensions": {"modes": {"dark": "{alias.color.error.400}", "light": "{alias.color.error.600}"}}}
  },
  "effect": {
   "scrim": {"$type": "color", "$value": "#00000099", "$extensions": {"modes": {"dark": "#00000099", "light": "#00000066"}}, "$description": "Behind modals only. Non-blocking panels get no scrim"},
   "glass": {"$type": "color", "$value": "#171717B8", "$extensions": {"modes": {"dark": "#171717B8", "light": "#FFFFFFB8"}}, "$description": "Nav and toolbars only, never content. Pair with blur 20px saturate 180%. Solid under prefers-reduced-transparency"},
   "glass-blur": {"$type": "dimension", "$value": "20px"},
   "shadow": {
    "sm": {"$type": "shadow", "$value": [{"color": "#0000000F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"}], "$description": "Light mode only. Dark mode uses surface steps + border instead"},
    "md": {"$type": "shadow", "$value": [{"color": "#00000014", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px"}, {"color": "#0000000A", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px"}]},
    "lg": {"$type": "shadow", "$value": [{"color": "#0000001F", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px"}, {"color": "#0000000F", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px"}]}
   }
  }
 },
 "responsive": {
  "$description": "Tier 4. Values that change by device. Modes: desktop (web), mobile (React Native).",
  "device-width": {"$type": "dimension", "$value": "1440px", "$extensions": {"modes": {"desktop": "1440px", "mobile": "390px"}}},
  "type": {
   "display": {
    "font-size": {"$type": "dimension", "$value": "48px", "$extensions": {"modes": {"desktop": "48px", "mobile": "40px"}}},
    "line-height": {"$type": "dimension", "$value": "56px", "$extensions": {"modes": {"desktop": "56px", "mobile": "48px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.bold}"},
    "letter-spacing": {"$type": "dimension", "$value": "-0.02em"}
   },
   "h1": {
    "font-size": {"$type": "dimension", "$value": "40px", "$extensions": {"modes": {"desktop": "40px", "mobile": "32px"}}},
    "line-height": {"$type": "dimension", "$value": "48px", "$extensions": {"modes": {"desktop": "48px", "mobile": "40px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.bold}"},
    "letter-spacing": {"$type": "dimension", "$value": "-0.02em"}
   },
   "h2": {
    "font-size": {"$type": "dimension", "$value": "32px", "$extensions": {"modes": {"desktop": "32px", "mobile": "28px"}}},
    "line-height": {"$type": "dimension", "$value": "40px", "$extensions": {"modes": {"desktop": "40px", "mobile": "36px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.bold}"},
    "letter-spacing": {"$type": "dimension", "$value": "-0.01em"}
   },
   "h3": {
    "font-size": {"$type": "dimension", "$value": "24px", "$extensions": {"modes": {"desktop": "24px", "mobile": "24px"}}},
    "line-height": {"$type": "dimension", "$value": "32px", "$extensions": {"modes": {"desktop": "32px", "mobile": "32px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.bold}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   },
   "h4": {
    "font-size": {"$type": "dimension", "$value": "20px", "$extensions": {"modes": {"desktop": "20px", "mobile": "20px"}}},
    "line-height": {"$type": "dimension", "$value": "28px", "$extensions": {"modes": {"desktop": "28px", "mobile": "28px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.bold}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   },
   "body-lg": {
    "font-size": {"$type": "dimension", "$value": "18px", "$extensions": {"modes": {"desktop": "18px", "mobile": "18px"}}},
    "line-height": {"$type": "dimension", "$value": "28px", "$extensions": {"modes": {"desktop": "28px", "mobile": "28px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.regular}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   },
   "body": {
    "font-size": {"$type": "dimension", "$value": "16px", "$extensions": {"modes": {"desktop": "16px", "mobile": "16px"}}},
    "line-height": {"$type": "dimension", "$value": "24px", "$extensions": {"modes": {"desktop": "24px", "mobile": "24px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.regular}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   },
   "body-sm": {
    "font-size": {"$type": "dimension", "$value": "14px", "$extensions": {"modes": {"desktop": "14px", "mobile": "14px"}}},
    "line-height": {"$type": "dimension", "$value": "20px", "$extensions": {"modes": {"desktop": "20px", "mobile": "20px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.regular}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   },
   "code": {
    "font-size": {"$type": "dimension", "$value": "14px", "$extensions": {"modes": {"desktop": "14px", "mobile": "14px"}}},
    "line-height": {"$type": "dimension", "$value": "20px", "$extensions": {"modes": {"desktop": "20px", "mobile": "20px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.regular}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"},
    "$description": "Code blocks. Ligatures on here only."
   },
   "caption": {
    "font-size": {"$type": "dimension", "$value": "12px", "$extensions": {"modes": {"desktop": "12px", "mobile": "12px"}}},
    "line-height": {"$type": "dimension", "$value": "16px", "$extensions": {"modes": {"desktop": "16px", "mobile": "16px"}}},
    "font-weight": {"$type": "fontWeight", "$value": "{brand.font.weight.medium}"},
    "letter-spacing": {"$type": "dimension", "$value": "0em"}
   }
  },
  "space": {
   "xs": {"$type": "dimension", "$value": "{brand.scale.100}", "$extensions": {"modes": {"desktop": "{brand.scale.100}", "mobile": "{brand.scale.100}"}}},
   "sm": {"$type": "dimension", "$value": "{brand.scale.200}", "$extensions": {"modes": {"desktop": "{brand.scale.200}", "mobile": "{brand.scale.200}"}}},
   "md": {"$type": "dimension", "$value": "{brand.scale.300}", "$extensions": {"modes": {"desktop": "{brand.scale.300}", "mobile": "{brand.scale.300}"}}},
   "lg": {"$type": "dimension", "$value": "{brand.scale.400}", "$extensions": {"modes": {"desktop": "{brand.scale.400}", "mobile": "{brand.scale.400}"}}},
   "xl": {"$type": "dimension", "$value": "{brand.scale.600}", "$extensions": {"modes": {"desktop": "{brand.scale.600}", "mobile": "{brand.scale.500}"}}},
   "2xl": {"$type": "dimension", "$value": "{brand.scale.800}", "$extensions": {"modes": {"desktop": "{brand.scale.800}", "mobile": "{brand.scale.600}"}}},
   "3xl": {"$type": "dimension", "$value": "{brand.scale.1000}", "$extensions": {"modes": {"desktop": "{brand.scale.1000}", "mobile": "{brand.scale.800}"}}}
  },
  "page-margin": {"$type": "dimension", "$value": "{brand.scale.800}", "$extensions": {"modes": {"desktop": "{brand.scale.800}", "mobile": "{brand.scale.400}"}}},
  "control-height": {
   "sm": {"$type": "dimension", "$value": "32px", "$extensions": {"modes": {"desktop": "32px", "mobile": "36px"}}},
   "md": {"$type": "dimension", "$value": "40px", "$extensions": {"modes": {"desktop": "40px", "mobile": "44px"}}},
   "lg": {"$type": "dimension", "$value": "48px", "$extensions": {"modes": {"desktop": "48px", "mobile": "52px"}}}
  },
  "hit-target-min": {"$type": "dimension", "$value": "44px", "$extensions": {"modes": {"desktop": "44px", "mobile": "44px"}}, "$description": "Apple minimum. Smaller visuals get invisible hit padding"}
 },
 "motion": {
  "$description": "Emil Kowalski + Apple. Only animate transform and opacity. Nothing keyboard-triggered animates.",
  "easing": {
   "out": {"$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1], "$description": "Default. Anything entering, exiting, or responding to the user"},
   "in-out": {"$type": "cubicBezier", "$value": [0.77, 0, 0.175, 1], "$description": "Elements already on screen moving A to B"},
   "drawer": {"$type": "cubicBezier", "$value": [0.32, 0.72, 0, 1], "$description": "Sheets and drawers"},
   "linear": {"$type": "cubicBezier", "$value": [0, 0, 1, 1], "$description": "Spinners and progress only"}
  },
  "duration": {
   "instant": {"$type": "duration", "$value": "0ms", "$description": "Keyboard actions, subsequent tooltips"},
   "press": {"$type": "duration", "$value": "160ms"},
   "fast": {"$type": "duration", "$value": "150ms", "$description": "Tooltips, small popovers, hover color"},
   "base": {"$type": "duration", "$value": "200ms", "$description": "Dropdowns, selects, toasts"},
   "modal": {"$type": "duration", "$value": "250ms"},
   "drawer": {"$type": "duration", "$value": "350ms"},
   "reduced": {"$type": "duration", "$value": "150ms", "$description": "Opacity crossfade used under prefers-reduced-motion"}
  },
  "spring": {
   "default": {"$type": "spring", "$value": {"bounce": 0, "duration": 0.4}, "$description": "Critically damped. Anything touchable"},
   "momentum": {"$type": "spring", "$value": {"bounce": 0.2, "duration": 0.4}, "$description": "Only after a flick or throw"}
  },
  "scale": {
   "press": {"$type": "number", "$value": 0.97},
   "enter": {"$type": "number", "$value": 0.95}
  },
  "blur-transition": {"$type": "dimension", "$value": "2px"}
 }
}
