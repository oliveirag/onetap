# Copy to .env (gitignored). Only public values belong here: secrets stay on the backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
# 1 = run every screen on typed fake data (no Supabase needed)
EXPO_PUBLIC_USE_MOCKS=1
# Dev only: stretch every app animation for review (e.g. 5)
EXPO_PUBLIC_SLOW_MOTION=
