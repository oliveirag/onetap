# Public values only — EXPO_PUBLIC_* variables are embedded in the app bundle.
# On a physical device replace localhost with your Mac's LAN IP (e.g. 192.168.1.20).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show the Developer Hardware screen in non-dev builds.
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false
